FROM amazonlinux:2023
RUN printf '[kernel-livepatch]\nname=AL2023 KLP\nmirrorlist=https://cdn.amazonlinux.com/al2023/kernel-livepatch/mirrors/al2023/$basearch/mirror.list\npriority=10\nenabled=1\nrepo_gpgcheck=0\ntype=rpm\ngpgcheck=1\ngpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-amazon-linux-2023\n\n[kernel-livepatch-source]\nname=AL2023 KLP src\nmirrorlist=https://cdn.amazonlinux.com/al2023/kernel-livepatch/mirrors/al2023/SRPMS/mirror.list\nenabled=0\nrepo_gpgcheck=0\ntype=rpm\ngpgcheck=1\ngpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-amazon-linux-2023\n' > /etc/yum.repos.d/kernel-livepatch.repo
RUN dnf install -y -q dnf-plugins-core gcc make flex bison bc elfutils-libelf-devel openssl-devel perl tar cpio rpm-build xz diffutils findutils patchutils gawk hostname && dnf clean all
